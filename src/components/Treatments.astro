---
import { Image } from "astro:assets";
import { services } from "../config/services";
import Icon from "./Icon.astro";
---

<section class="py-24 bg-gradient-to-b from-cream via-cream to-cream" id="treatments">
	<div class="max-w-[1280px] mx-auto px-5 md:px-16">
		<div class="text-center mb-14 md:mb-16" data-reveal>
			<span class="text-xs uppercase tracking-[0.3em] text-brand font-semibold"
				>Especialidades</span
			>
			<h2 class="font-display text-3xl md:text-4xl font-bold text-teal-900 mt-4">
				Nuestros Tratamientos
			</h2>
			<p class="text-sm text-ink-soft mt-4">
				Soluciones odontológicas avanzadas para cuidar tu sonrisa en cada etapa.
			</p>
		</div>

		<div class="grid grid-cols-1 md:grid-cols-2 gap-8">
			{
			services.map((item, index) => (
				<article
					class="group bg-surface rounded-2xl overflow-hidden ambient-shadow border border-slate-200 flex flex-col hover:-translate-y-1.5 hover:shadow-hover transition-all duration-500 reveal reveal-zoom"
					id={item.slug}
					data-reveal
					data-reveal-delay={(index % 2) * 100}
				>
						<div class="h-64 overflow-hidden relative">
							<Image
								src={item.image}
								class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
								alt={item.alt}
								format="webp"
								widths={[480, 640]}
								sizes="(max-width: 768px) 100vw, 50vw"
								loading="lazy"
								decoding="async"
							/>
							<div
								class="absolute inset-0 bg-gradient-to-t from-ink/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"
							></div>
							<span
								class="absolute top-4 left-4 bg-white/90 backdrop-blur-md text-ink px-3 py-1 rounded-full text-xs font-semibold shadow-md"
							>
								{item.category}
							</span>
							<span
								class="absolute bottom-4 right-4 text-[11px] text-white/90 bg-ink/50 backdrop-blur-md px-2.5 py-1 rounded-full"
							>
								{item.duration}
							</span>
						</div>
						<div class="p-8 flex flex-col flex-grow">
							<h3 class="font-display text-2xl font-bold text-ink mb-4">
								{item.title}
							</h3>
							<p class="text-sm text-ink-soft mb-6 flex-grow leading-relaxed">
								{item.description}
							</p>
							<button
								class="self-start inline-flex items-center gap-2 text-brand font-semibold text-sm group/btn hover:text-brand-dark transition-colors duration-300 cursor-pointer min-h-11 px-2 -mx-2"
							>
								VER MÁS
								<Icon
									name="arrow_forward"
									size={16}
									class="transition-transform duration-300 group-hover/btn:translate-x-1"
								/>
							</button>
						</div>
					</article>
				))
			}
		</div>
	</div>
</section>
