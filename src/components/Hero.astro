---
import { Picture } from "astro:assets";
import { siteConfig } from "../config/siteConfig";
import heroImage from "../assets/images/ortodoncia-hero.jpg";

const { hero, contact } = siteConfig;
---

<section class="relative w-full min-h-[88vh] flex items-center justify-center overflow-hidden">
	<div class="absolute inset-0 z-0">
		<Picture
			src={heroImage}
			formats={["avif", "webp"]}
			widths={[480, 768, 1024, 1600]}
			sizes="100vw"
			priority
			class="hero-zoom w-full h-full object-cover"
			alt="Consultorio dental moderno de Aura Dental"
		/>
		<div class="absolute inset-0 bg-gradient-to-b from-cream/90 via-cream/65 to-cream"></div>
		<div class="absolute inset-0 bg-gradient-to-tr from-ink/25 via-transparent to-transparent"></div>
	</div>

	<div
		class="relative z-10 max-w-[1280px] mx-auto px-5 md:px-16 text-center flex flex-col items-center gap-7 pt-24 pb-20"
	>
		<span
			class="hero-fade hero-fade-1 inline-flex items-center gap-2.5 px-5 py-2 rounded-full bg-white/70 backdrop-blur-md border border-ink/10 text-[11px] uppercase tracking-[0.25em] text-brand font-semibold shadow-card"
		>
			<span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
			{hero.badge}
		</span>

		<h1
			class="hero-fade hero-fade-2 font-display text-5xl md:text-7xl font-extrabold text-ink max-w-4xl leading-[1.05]"
		>
			{hero.title}
			<span class="text-gradient block mt-3">{hero.titleAccent}</span>
		</h1>

		<p class="hero-fade hero-fade-3 text-lg md:text-xl text-ink-soft max-w-2xl leading-relaxed">
			{hero.subtitle}
		</p>

		<div class="hero-fade hero-fade-4 flex flex-col sm:flex-row gap-4 mt-2">
			<a
				href={contact.phoneHref}
				class="group inline-flex items-center gap-2 bg-cta text-white px-9 py-4 rounded-full font-semibold text-sm tracking-wider shadow-lg shadow-orange-500/30 hover:bg-cta-hover hover:shadow-xl hover:shadow-orange-500/40 hover:-translate-y-1 active:translate-y-0 transition-all duration-300"
			>
				{hero.primaryCta}
				<span class="transition-transform duration-300 group-hover:translate-x-1.5">→</span>
			</a>
			<a
				href="#treatments"
				class="inline-flex items-center justify-center px-9 py-4 rounded-full font-semibold text-sm tracking-wider text-ink bg-white/70 backdrop-blur-md border border-ink/10 hover:bg-white hover:border-brand/40 hover:-translate-y-1 active:translate-y-0 transition-all duration-300"
			>
				{hero.secondaryCta}
			</a>
		</div>
	</div>
</section>
