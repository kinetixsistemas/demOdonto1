---
import { siteConfig } from "../config/siteConfig";

const { nav, name, tagline, contact } = siteConfig;
---

<header class="fixed top-0 inset-x-0 z-50">
	<div
		class="max-w-[1280px] mx-auto px-5 md:px-16 py-4 flex justify-between items-center bg-cream/85 backdrop-blur-xl shadow-[0_1px_0_rgba(11,28,48,0.08)]"
	>
		<a href="/" class="flex items-center gap-3 group" aria-label={name}>
			<span
				class="w-10 h-10 rounded-full bg-gradient-to-br from-brand to-brand-dark text-white flex items-center justify-center font-display font-semibold text-sm shadow-glow transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6"
			>
				A
			</span>
			<span class="hidden md:block font-display text-lg font-medium text-ink leading-tight">
				{name}
				<span
					class="block text-[10px] uppercase tracking-[0.35em] text-accent font-sans font-semibold mt-0.5"
					>{tagline}</span
				>
			</span>
		</a>

		<nav class="hidden md:flex items-center gap-8">
			{
				nav.map((link) => (
					<a
						href={link.href}
						class="relative py-1 text-sm font-medium text-ink-soft hover:text-ink transition-colors duration-300 group"
					>
						{link.label}
						<span
							class="absolute left-0 bottom-0 h-[2px] w-0 bg-gradient-to-r from-brand to-accent transition-all duration-300 group-hover:w-full rounded-full"
						></span>
					</a>
				))
			}
		</nav>

		<div class="flex items-center gap-3">
			<a
				href={contact.phoneHref}
				class="hidden md:inline-block bg-cta text-white px-6 py-2.5 rounded-full font-semibold text-sm shadow-md shadow-orange-500/30 hover:bg-cta-hover hover:shadow-lg hover:shadow-orange-500/40 hover:-translate-y-0.5 active:translate-y-0 active:scale-95 transition-all duration-300"
			>
				Agenda tu cita
			</a>

			<button
				id="menu-toggle"
				class="md:hidden w-10 h-10 flex items-center justify-center rounded-full bg-white border border-ink/10 text-ink hover:bg-brand hover:text-white transition-colors duration-300 cursor-pointer"
				aria-label="Abrir menú"
				aria-expanded="false"
			>
				<span id="icon-open" class="material-symbols-outlined">menu</span>
				<span id="icon-close" class="material-symbols-outlined hidden">close</span>
			</button>
		</div>
	</div>

	<!-- Menú móvil -->
	<div
		id="mobile-menu"
		class="hidden md:hidden mx-4 bg-white rounded-2xl shadow-hover border border-slate-200 p-4 mt-2"
	>
		<nav class="flex flex-col gap-1">
			{
				nav.map((link) => (
					<a
						href={link.href}
						class="px-4 py-3 rounded-xl text-sm font-medium text-ink-soft hover:text-white hover:bg-gradient-to-r hover:from-brand hover:to-brand-dark transition-all duration-300"
					>
						{link.label}
					</a>
				))
			}
			<a
				href={contact.phoneHref}
				class="mt-2 text-center bg-cta hover:bg-cta-hover text-white px-6 py-3 rounded-full font-semibold text-sm transition-colors duration-300"
			>
				Agenda tu cita
			</a>
		</nav>
	</div>
</header>

<script>
	const toggle = document.getElementById("menu-toggle");
	const menu = document.getElementById("mobile-menu");
	const iconOpen = document.getElementById("icon-open");
	const iconClose = document.getElementById("icon-close");

	toggle?.addEventListener("click", () => {
		const isOpen = menu?.classList.toggle("hidden") === false;
		toggle.setAttribute("aria-expanded", String(isOpen));
		iconOpen?.classList.toggle("hidden", isOpen);
		iconClose?.classList.toggle("hidden", !isOpen);
	});

	menu?.querySelectorAll("a").forEach((link) => {
		link.addEventListener("click", () => {
			menu.classList.add("hidden");
			toggle.setAttribute("aria-expanded", "false");
			iconOpen?.classList.remove("hidden");
			iconClose?.classList.add("hidden");
		});
	});
</script>
