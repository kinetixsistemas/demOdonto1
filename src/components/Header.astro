---
import { siteConfig } from "../config/siteConfig";
import Icon from "./Icon.astro";

const { nav = [], name = "", tagline = "", contact = { phoneHref: "#" } } = siteConfig;
---

<header class="fixed inset-x-0 top-0 z-50">
	<div
		class="mx-auto flex max-w-[1280px] items-center justify-between bg-cream/85 px-5 py-4 backdrop-blur-xl shadow-[0_1px_0_rgba(11,28,48,0.08)] md:px-16"
		data-header
	>
		<!-- Logo / Branding -->
		<a href="/" class="group flex items-center gap-3" aria-label={name}>
			<span
				class="flex h-10 w-10 items-center justify-center rounded-full bg-gradient-to-br from-brand to-brand-dark font-display text-sm font-semibold text-white shadow-glow transition-transform duration-300 group-hover:rotate-6 group-hover:scale-110"
			>
				{name.charAt(0) || "A"}
			</span>
			<span class="hidden font-display text-lg font-medium leading-tight text-ink md:block">
				{name}
				<span
					class="mt-0.5 block font-sans text-[10px] font-semibold uppercase tracking-[0.35em] text-brand"
				>
					{tagline}
				</span>
			</span>
		</a>

		<!-- Navegación Desktop -->
		<nav class="hidden items-center gap-8 md:flex" aria-label="Navegación principal">
			{
				nav.map((link) => (
					<a
						href={link.href}
						class="group relative py-1 text-sm font-medium text-ink-soft transition-colors duration-300 hover:text-ink"
					>
						{link.label}
						<span
							class="absolute bottom-0 left-0 h-[2px] w-0 rounded-full bg-gradient-to-r from-brand to-accent transition-all duration-300 group-hover:w-full"
							aria-hidden="true"
						/>
					</a>
				))
			}
		</nav>

		<!-- Botón de Acción y Toggle Móvil -->
		<div class="flex items-center gap-3">
			<a
				href={contact.phoneHref}
				class="hidden rounded-full bg-cta px-6 py-3 font-semibold text-sm text-white shadow-md shadow-orange-500/30 transition-all duration-300 hover:-translate-y-0.5 hover:bg-cta-hover hover:shadow-lg hover:shadow-orange-500/40 active:scale-95 active:translate-y-0 md:inline-block"
			>
				Agenda tu cita
			</a>

			<button
				id="menu-toggle"
				class="flex h-11 w-11 cursor-pointer items-center justify-center rounded-full border border-ink/10 bg-white text-ink transition-colors duration-300 hover:bg-brand hover:text-white md:hidden"
				aria-label="Abrir menú de navegación"
				aria-expanded="false"
				aria-controls="mobile-menu"
			>
				<Icon id="icon-open" name="menu" aria-hidden="true" />
				<Icon id="icon-close" name="close" class="hidden" aria-hidden="true" />
			</button>
		</div>
	</div>

	<!-- Menú Móvil -->
	<div
		id="mobile-menu"
		class="mx-4 mt-2 hidden rounded-2xl border border-slate-200 bg-white p-4 shadow-hover md:hidden"
	>
		<nav class="flex flex-col gap-1" aria-label="Navegación móvil">
			{
				nav.map((link) => (
					<a
						href={link.href}
						class="rounded-xl px-4 py-4 text-sm font-medium text-ink-soft transition-all duration-300 hover:bg-gradient-to-r hover:from-brand hover:to-brand-dark hover:text-white"
					>
						{link.label}
					</a>
				))
			}
			<a
				href={contact.phoneHref}
				class="mt-2 rounded-full bg-cta px-6 py-3 text-center text-sm font-semibold text-white transition-colors duration-300 hover:bg-cta-hover"
			>
				Agenda tu cita
			</a>
		</nav>
	</div>
</header>

<script>
	const setupMobileMenu = () => {
		const toggle = document.getElementById("menu-toggle");
		const menu = document.getElementById("mobile-menu");
		const iconOpen = document.getElementById("icon-open");
		const iconClose = document.getElementById("icon-close");

		if (!toggle || !menu) return;

		const toggleMenu = (shouldOpen?: boolean) => {
			const isHidden = menu.classList.contains("hidden");
			const state = shouldOpen !== undefined ? !shouldOpen : isHidden;

			menu.classList.toggle("hidden", !state);
			toggle.setAttribute("aria-expanded", String(state));
			toggle.setAttribute("aria-label", state ? "Cerrar menú de navegación" : "Abrir menú de navegación");

			iconOpen?.classList.toggle("hidden", state);
			iconClose?.classList.toggle("hidden", !state);
		};

		toggle.addEventListener("click", () => toggleMenu());

		// Cerrar al hacer clic en cualquier enlace interno
		menu.querySelectorAll("a").forEach((link) => {
			link.addEventListener("click", () => toggleMenu(false));
		});

		// Cerrar con la tecla Escape
		document.addEventListener("keydown", (e) => {
			if (e.key === "Escape" && !menu.classList.contains("hidden")) {
				toggleMenu(false);
			}
		});
	};

	// Ejecutar script asegurando compatibilidad con View Transitions
	setupMobileMenu();
	document.addEventListener("astro:page-load", setupMobileMenu);
</script>