---
import Icon from "./Icon.astro";

interface CoverFlowImage {
	src: string;
	title: string;
	description?: string;
	icon?: string;
}

interface Props {
	className?: string;
	images?: CoverFlowImage[];
	isMonochrome?: boolean;
	autoPlay?: boolean;
	autoPlayInterval?: number;
}

const DEFAULT_ASSETS: CoverFlowImage[] = [
	{
		src: "https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=600&q=80",
		title: "DISEÑO RESPONSIVE",
	},
	{
		src: "https://images.unsplash.com/photo-1470071459604-3b5ec3a7fe05?auto=format&fit=crop&w=600&q=80",
		title: "CARGA RÁPIDA",
	},
	{
		src: "https://images.unsplash.com/photo-1447752875215-b2761acb3c5d?auto=format&fit=crop&w=600&q=80",
		title: "WHATSAPP INTEGRADO",
	},
	{
		src: "https://images.unsplash.com/photo-1441974231531-c6227db76b6e?auto=format&fit=crop&w=600&q=80",
		title: "RESEÑAS QUE GENERAN CONFIANZA",
	},
	{
		src: "https://images.unsplash.com/photo-1501854140801-50d01698950b?auto=format&fit=crop&w=600&q=80",
		title: "RESERVA DE CITAS",
	},
	{
		src: "https://images.unsplash.com/photo-1501854140801-50d01698950b?auto=format&fit=crop&w=600&q=80",
		title: "IMAGEN PROFESIONAL",
	},
];

const {
	className = "",
	images = DEFAULT_ASSETS,
	isMonochrome = false,
	autoPlay = true,
	autoPlayInterval = 4000,
} = Astro.props;

const initialIndex = Math.min(2, images.length - 1);

function cardTransform(offset: number) {
	const isActive = offset === 0;
	const isPast = offset < 0;
	const absOffset = Math.abs(offset);
	return {
		transform: `translateX(${offset * 66}px) rotateY(${isActive ? 0 : isPast ? 40 : -40}deg) translateZ(${isActive ? 60 : -absOffset * 55}px) scale(${isActive ? 1.12 : Math.max(0.72, 1 - absOffset * 0.09)})`,
		opacity:
			absOffset > 2 ? "0" : String(Math.max(0.25, 1 - absOffset * 0.3)),
		zIndex: String(100 - absOffset),
	};
}
---

<div
	data-coverflow
	data-count={images.length}
	data-autoplay={autoPlay}
	data-interval={autoPlayInterval}
	class={`relative w-full h-full flex flex-col items-center justify-center overflow-hidden rounded-3xl bg-gradient-to-b from-slate-900 to-slate-950 select-none [touch-action:pan-y] ${className}`}
	style="perspective: 1200px"
>
	<div
		class="pointer-events-none absolute -top-28 left-1/2 -translate-x-1/2 w-[580px] h-[680px] rounded-full bg-brand/20 blur-[130px]"
	>
	</div>
	<div
		class="pointer-events-none absolute -bottom-32 -right-16 w-[360px] h-[360px] rounded-full bg-accent/10 blur-[110px]"
	>
	</div>

	<div
		class="relative w-full flex justify-center items-center h-[400px] md:h-[450px] [transform-style:preserve-3d]"
	>
		{
			images.map((item, i) => {
				const isActive = i === initialIndex;
				const { transform, opacity, zIndex } = cardTransform(
					i - initialIndex,
				);
				const style = `transform:${transform};opacity:${opacity};z-index:${zIndex}`;
				return (
					<div
						class="cf-card absolute w-[300px] aspect-[3/4] cursor-pointer mt-8 pt-6"
						style={style}
						data-card
						data-active={isActive}
						role="button"
						tabindex="0"
						aria-label={`Ver ${item.title}`}
					>
						{isMonochrome ? (
							<div class="w-full h-full rounded-2xl bg-gradient-to-br from-neutral-500 to-neutral-800 border border-white/20 shadow-2xl flex items-center justify-center text-white/70 font-bold text-lg">
								{i + 1}
							</div>
						) : (
							<div class="relative w-full h-full">
								<img
									class="cf-img w-full h-full object-cover rounded-2xl border shadow-2xl transition-shadow duration-300"
									src={item.src}
									alt={item.title}
									referrerpolicy="no-referrer"
									loading="lazy"
									draggable="false"
								/>
								<div class="cf-overlay absolute inset-0 rounded-2xl bg-gradient-to-t from-ink/70 via-transparent to-transparent transition-opacity duration-300" />
								<div class="cf-ring absolute inset-0 rounded-2xl ring-1 ring-white/30 pointer-events-none" />
							</div>
						)}
					</div>
				);
			})
		}
	</div>

	<div class="relative z-20 mt-10 flex flex-col items-center gap-5">
		<div class="relative h-24 w-full max-w-[300px]">
			{
				images.map((item, i) => (
					<div
						class={`cf-chip absolute inset-0 flex items-center justify-center ${i === initialIndex ? "" : "hidden"}`}
						data-chip
						data-chip-index={i}
					>
						{isMonochrome ? (
							<p class="px-4 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/15 text-xs font-medium text-white/90 tracking-wide">
								Card {i + 1}
							</p>
						) : (
							<div class="flex flex-col items-center gap-1.5 px-5 py-3.5 rounded-2xl bg-white/10 backdrop-blur-md border border-white/15 text-center max-w-[300px]">
								{item.icon && (
									<Icon
										name={item.icon}
										size={24}
										class="text-white"
									/>
								)}
								<p class="text-xs font-semibold text-white tracking-wide uppercase">
									{item.title}
								</p>
								{item.description && (
									<p class="text-xs leading-relaxed text-white/70">
										{item.description}
									</p>
								)}
							</div>
						)}
					</div>
				))
			}
		</div>

		<div
			class="flex items-center gap-2 px-2 py-1.5 rounded-full bg-white/10 backdrop-blur-md border border-white/10 shadow-lg"
		>
			<button
				type="button"
				data-prev
				class="w-11 h-11 flex items-center justify-center rounded-full text-white/70 hover:text-white hover:bg-white/15 active:scale-90 transition-all duration-200 cursor-pointer"
				aria-label="Anterior"
			>
				<svg
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg
				>
			</button>

			<div class="flex items-center gap-2">
				{
					images.map((_, i) => (
						<button
							type="button"
							data-dot
							data-dot-index={i}
							aria-label={`Ir a la tarjeta ${i + 1}`}
							class="w-10 h-11 flex items-center justify-center cursor-pointer transition-all duration-300"
						>
							<span
								class="cf-dot"
								data-active={i === initialIndex}
							/>
						</button>
					))
				}
			</div>

			<button
				type="button"
				data-next
				class="w-11 h-11 flex items-center justify-center rounded-full text-white/70 hover:text-white hover:bg-white/15 active:scale-90 transition-all duration-200 cursor-pointer"
				aria-label="Siguiente"
			>
				<svg
					width="20"
					height="20"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
					aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg
				>
			</button>
		</div>
	</div>
</div>

<style>
	.cf-card {
		transition:
			transform 0.55s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.55s ease;
	}
	.cf-img {
		border-color: rgb(255 255 255 / 0.1);
	}
	.cf-card[data-active="true"] .cf-img {
		border-color: rgb(255 255 255 / 0.3);
		box-shadow: 0 8px 32px -4px rgb(15 118 110 / 0.35);
	}
	.cf-overlay {
		opacity: 0.25;
	}
	.cf-card[data-active="true"] .cf-overlay {
		opacity: 1;
	}
	.cf-ring {
		opacity: 0;
		transition: opacity 0.3s ease;
	}
	.cf-card[data-active="true"] .cf-ring {
		opacity: 1;
	}
	.cf-dot {
		width: 0.5rem;
		height: 0.5rem;
		border-radius: 9999px;
		background-color: rgb(255 255 255 / 0.3);
		transition:
			width 0.3s ease,
			background-color 0.3s ease;
	}
	.cf-dot[data-active="true"] {
		width: 1.5rem;
		background-color: #fff;
	}
	@media (prefers-reduced-motion: reduce) {
		.cf-card,
		.cf-dot {
			transition: none !important;
		}
	}
</style>

<script>
	const root = document.querySelector("[data-coverflow]");
	if (root) {
		const count = Number(root.dataset.count || 0);
		const autoPlay = root.dataset.autoplay === "true";
		const intervalMs = Number(root.dataset.interval || 4000);
		const reduced = window.matchMedia(
			"(prefers-reduced-motion: reduce)",
		).matches;

		const cards = Array.from(root.querySelectorAll("[data-card]"));
		const chips = Array.from(root.querySelectorAll("[data-chip]"));
		const dots = Array.from(root.querySelectorAll("[data-dot]"));
		const prevBtn = root.querySelector("[data-prev]");
		const nextBtn = root.querySelector("[data-next]");

		const clamp = (i) => Math.max(0, Math.min(count - 1, i));
		let activeIndex = Math.min(2, count - 1);
		let timer = null;
		let hovering = false;

		function apply(card, i) {
			const offset = i - activeIndex;
			const isActive = offset === 0;
			const isPast = offset < 0;
			const absOffset = Math.abs(offset);
			card.style.transform = `translateX(${offset * 66}px) rotateY(${isActive ? 0 : isPast ? 40 : -40}deg) translateZ(${isActive ? 60 : -absOffset * 55}px) scale(${isActive ? 1.12 : Math.max(0.72, 1 - absOffset * 0.09)})`;
			card.style.opacity =
				absOffset > 2
					? "0"
					: String(Math.max(0.25, 1 - absOffset * 0.3));
			card.style.zIndex = String(100 - absOffset);
			card.dataset.active = String(isActive);
		}

		function updateInfo() {
			chips.forEach((chip) => {
				const show = Number(chip.dataset.chipIndex) === activeIndex;
				chip.classList.toggle("hidden", !show);
				if (show && !reduced) {
					chip.getAnimations().forEach((a) => a.cancel());
					chip.animate(
						[
							{ opacity: 0, transform: "translateY(8px)" },
							{ opacity: 1, transform: "translateY(0)" },
						],
						{ duration: 450, easing: "ease-out", fill: "both" },
					);
				}
			});
			dots.forEach((dot) => {
				dot.querySelector(".cf-dot").dataset.active = String(
					Number(dot.dataset.dotIndex) === activeIndex,
				);
			});
		}

		function render() {
			cards.forEach(apply);
			updateInfo();
		}

		function stop() {
			if (timer) {
				clearInterval(timer);
				timer = null;
			}
		}

		function start() {
			stop();
			if (
				!autoPlay ||
				reduced ||
				hovering ||
				document.hidden ||
				count < 2
			)
				return;
			timer = setInterval(() => {
				activeIndex = clamp(activeIndex + 1);
				render();
			}, intervalMs);
		}

		function goTo(index) {
			activeIndex = clamp(index);
			render();
		}

		prevBtn?.addEventListener("click", () => goTo(activeIndex - 1));
		nextBtn?.addEventListener("click", () => goTo(activeIndex + 1));

		cards.forEach((card, i) => {
			card.addEventListener("click", () => goTo(i));
			card.addEventListener("keydown", (e) => {
				if (e.key === "Enter" || e.key === " ") {
					e.preventDefault();
					goTo(i);
				}
			});
		});

		dots.forEach((dot) => {
			dot.addEventListener("click", () =>
				goTo(Number(dot.dataset.dotIndex)),
			);
		});

		let touchStartX = null;
		root.addEventListener("touchstart", (e) => {
			touchStartX = e.touches[0].clientX;
			stop();
		});
		root.addEventListener("touchend", (e) => {
			if (touchStartX !== null) {
				const dx = e.changedTouches[0].clientX - touchStartX;
				touchStartX = null;
				if (Math.abs(dx) > 40) goTo(activeIndex + (dx < 0 ? 1 : -1));
			}
			if (!hovering) start();
		});

		root.addEventListener("mouseenter", () => {
			hovering = true;
			stop();
		});
		root.addEventListener("mouseleave", () => {
			hovering = false;
			start();
		});

		document.addEventListener("visibilitychange", () => {
			if (document.hidden) stop();
			else if (!hovering) start();
		});

		render();
		start();
	}
</script>
