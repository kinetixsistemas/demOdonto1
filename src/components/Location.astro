---
import { siteConfig } from "../config/siteConfig";
import { schedule, availability } from "../config/schedule";
import Icon from "./Icon.astro";

const { contact, address } = siteConfig;

const infoItems = [
	{
		icon: "location_on",
		title: "Dirección",
		lines: [address.line1, `${address.city}, ${address.country}.`],
	},
	{
		icon: "phone",
		title: "Teléfono",
		lines: [contact.phone],
		href: contact.phoneHref,
	},
	{
		icon: "mail",
		title: "Email",
		lines: [contact.email],
		href: `mailto:${contact.email}`,
	},
];
---

<section class="py-24 bg-cream" id="location">
	<div class="max-w-[1280px] mx-auto px-5 md:px-16">
		<div class="text-center mb-16" data-reveal>
			<span class="text-xs uppercase tracking-[0.3em] text-brand font-semibold"
				>Contáctanos</span
			>
			<h2 class="font-display text-3xl md:text-4xl font-bold text-teal-900 mt-4">
				Visítanos
			</h2>
			<p class="text-sm text-ink-soft mt-4">
				Ubicados en el corazón de la zona médica más exclusiva de la
				ciudad.
			</p>
		</div>

		<div class="grid grid-cols-1 lg:grid-cols-5 gap-12 items-stretch">
			<div class="lg:col-span-2 flex flex-col gap-6">
				{
					infoItems.map((item, index) => (
						<div
							class="group flex items-start gap-5 bg-surface rounded-2xl p-6 ambient-shadow border border-slate-200 hover:-translate-y-1 hover:shadow-hover transition-all duration-300 reveal reveal-left"
							data-reveal
							data-reveal-delay={index * 80}
						>
							<span
								class="w-12 h-12 shrink-0 rounded-xl bg-brand-soft text-brand flex items-center justify-center transition-all duration-300 group-hover:bg-gradient-to-br group-hover:from-brand group-hover:to-brand-dark group-hover:text-white"
							>
								<Icon name={item.icon} size={24} />
							</span>
							<div>
								<h3 class="font-semibold text-sm text-ink">{item.title}</h3>
								{
									item.lines.map((line) => (
										<p class="text-sm text-ink-soft leading-relaxed">{line}</p>
									))
								}
								{
									item.href && (
										<a
											href={item.href}
											class="mt-2 inline-flex items-center gap-1 text-xs font-semibold text-brand hover:text-brand-dark transition-colors duration-300"
										>
											{item.title === "Dirección"
												? "Abrir en Google Maps"
												: "Contactar"}
											<Icon name="arrow_forward" size={14} />
										</a>
									)
								}
							</div>
						</div>
					))
				}

			<div
				class="bg-surface rounded-2xl p-6 ambient-shadow border border-slate-200 reveal reveal-left"
				data-reveal
				data-reveal-delay="240"
			>
					<div class="flex items-center gap-3 mb-4">
						<span
							class="w-12 h-12 shrink-0 rounded-xl bg-brand-soft text-brand flex items-center justify-center"
						>
							<Icon name="schedule" size={24} />
						</span>
						<div>
							<h3 class="font-semibold text-sm text-ink">Horario de Atención</h3>
							<p class="text-xs text-ink-soft">{availability.bookingNote}</p>
						</div>
					</div>
					<ul class="space-y-2">
						{
							schedule.map((day) => (
								<li
									class="flex items-center justify-between text-sm px-3 py-1.5 rounded-lg"
								>
									<span
										class:list={[
											"font-medium",
											day.isOpen ? "text-ink" : "text-ink-soft",
										]}
									>
										{day.day}
									</span>
									<span
										class:list={[
											"inline-flex items-center gap-1.5",
											day.isOpen ? "text-brand" : "text-ink-soft",
										]}
									>
										<span
											class:list={[
												"w-1.5 h-1.5 rounded-full",
												day.isOpen ? "bg-brand" : "bg-ink-soft/40",
											]}
										></span>
										{day.isOpen ? `${day.open} - ${day.close}` : "Cerrado"}
									</span>
								</li>
							))
						}
					</ul>
					<p class="mt-4 text-xs text-ink-soft flex items-center gap-1.5">
						<Icon name="bolt" size={14} />
						{availability.responseTime}
					</p>
				</div>
			</div>

			<div
				class="lg:col-span-3 flex flex-col gap-4 h-full min-h-96 reveal reveal-right"
				data-reveal
				data-reveal-delay="160"
			>
				<div
					class="relative flex-1 min-h-[420px] rounded-3xl overflow-hidden ambient-shadow ring-1 ring-ink/5 bg-brand-soft"
				>
					<iframe
						class="absolute inset-0 w-full h-full border-0"
						src={address.mapsEmbed}
						title="Mapa de ubicación de Aura Dental"
						style="filter: saturate(0.9) contrast(1.05)"
						loading="lazy"
						referrerpolicy="no-referrer-when-downgrade"
						allowfullscreen
					></iframe>

					<div
						class="absolute inset-x-4 bottom-4 sm:inset-x-6 sm:bottom-6 bg-white/95 backdrop-blur rounded-2xl p-5 shadow-hover ring-1 ring-ink/5"
					>
						<div class="flex flex-col sm:flex-row sm:items-center gap-4">
							<div class="flex items-start gap-3 min-w-0">
								<span
									class="w-11 h-11 shrink-0 rounded-xl bg-brand-soft text-brand flex items-center justify-center"
								>
									<Icon name="location_on" size={22} />
								</span>
								<div class="min-w-0">
									<h3 class="font-semibold text-sm text-ink">
										{address.line1}
									</h3>
									<p class="text-xs text-ink-soft mt-0.5">
										{address.city}, {address.country}
									</p>
								</div>
							</div>
							<a
								href={address.mapsDirections}
								target="_blank"
								rel="noopener noreferrer"
								class="inline-flex items-center justify-center gap-2 shrink-0 px-5 py-3 rounded-xl bg-gradient-to-br from-brand to-brand-dark text-white text-sm font-semibold shadow-glow hover:brightness-110 hover:-translate-y-0.5 transition-all duration-300"
							>
								<Icon name="arrow_forward" size={18} />
								Cómo llegar
							</a>
						</div>
					</div>
				</div>

				<a
					href={address.mapsDirections}
					target="_blank"
					rel="noopener noreferrer"
					class="inline-flex items-center justify-center gap-2 text-xs font-semibold text-brand hover:text-brand-dark transition-colors duration-300"
				>
					<Icon name="location_on" size={16} />
					Ver ubicación en Google Maps
				</a>
			</div>
		</div>
	</div>
</section>
