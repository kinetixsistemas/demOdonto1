---
import { siteConfig } from "../config/siteConfig";

const { name, tagline, footer, socials } = siteConfig;
---

<footer
	class="w-full px-5 md:px-16 py-20 flex flex-col items-center gap-6 text-center bg-slate-900 text-white font-normal text-xs"
>
	<a href="/" class="flex items-center gap-3 group mb-4" aria-label={name}>
		<span
			class="w-11 h-11 rounded-full bg-gradient-to-br from-brand to-brand-dark flex items-center justify-center font-display font-semibold text-base shadow-glow transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6"
		>
			A
		</span>
		<span class="text-left font-display text-2xl font-medium text-cream leading-tight">
			{name}
			<span
				class="block text-[10px] uppercase tracking-[0.35em] text-accent font-sans font-semibold mt-0.5"
				>{tagline}</span
			>
		</span>
	</a>

	<p class="max-w-md text-slate-400 leading-relaxed">{footer.description}</p>

	<div class="flex items-center gap-4 mb-4">
		{
			Object.entries(socials).map(([label, href]) => (
				<a
					href={href}
					target="_blank"
					rel="noopener noreferrer"
					aria-label={label}
					class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:bg-brand hover:border-brand hover:text-white hover:-translate-y-1 transition-all duration-300"
				>
					<span class="material-symbols-outlined !text-[18px]">{label}</span>
				</a>
			))
		}
	</div>

	<div class="flex flex-wrap justify-center gap-8 mb-2">
		{
			footer.links.map((link) => (
				<a
					class="text-slate-400 hover:text-white transition-colors duration-300 hover:underline underline-offset-4"
					href={link.href}
				>
					{link.label}
				</a>
			))
		}
	</div>

	<div class="flex items-center gap-2 mt-4">
		<span class="w-1.5 h-1.5 rounded-full bg-accent"></span>
		<p class="text-slate-400">{footer.rights}</p>
	</div>
</footer>
