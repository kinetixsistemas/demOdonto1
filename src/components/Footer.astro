---
import { siteConfig } from "../config/siteConfig";
import Icon from "./Icon.astro";

const { name, tagline, footer, socials, nav } = siteConfig;
---

<footer
	class="w-full px-5 md:px-16 py-14 flex flex-col items-center text-center bg-slate-900 text-white font-normal text-xs"
>
	<div class="w-full max-w-[1280px] grid grid-cols-1 md:grid-cols-3 gap-10 items-start md:items-center">
		<div class="flex flex-col items-center md:items-start gap-4">
			<a href="/" class="flex items-center gap-2.5 group">
				<span
					class="w-9 h-9 rounded-full bg-gradient-to-br from-brand to-brand-dark flex items-center justify-center font-display font-semibold text-sm shadow-glow transition-transform duration-300 group-hover:scale-110 group-hover:rotate-6"
				>
					A
				</span>
				<span class="text-left font-display text-lg font-medium text-cream leading-tight">
					{name}
					<span
						class="block text-[9px] uppercase tracking-[0.3em] text-accent font-sans font-semibold mt-0.5"
						>{tagline}</span
					>
				</span>
			</a>

			<p class="max-w-[260px] text-slate-400 leading-relaxed">
				{footer.description}
			</p>
		</div>

		<nav class="flex flex-wrap justify-center gap-x-8 gap-y-3">
			{
				nav.map((link) => (
					<a
						href={link.href}
						class="text-slate-400 hover:text-white transition-colors duration-300 hover:underline underline-offset-4"
					>
						{link.label}
					</a>
				))
			}
		</nav>

		<div class="flex items-center justify-center md:justify-end gap-3">
			{
				Object.entries(socials).map(([label, href]) => (
					<a
						href={href}
						target="_blank"
						rel="noopener noreferrer"
						aria-label={label}
						title={label}
						class="w-10 h-10 rounded-full bg-white/5 border border-white/10 flex items-center justify-center text-slate-400 hover:bg-brand hover:border-brand hover:text-white hover:-translate-y-1 transition-all duration-300"
					>
						<Icon name={label} size={17} />
					</a>
				))
			}
		</div>
	</div>

	<div
		class="w-full max-w-[1280px] mt-10 pt-6 border-t border-white/10 flex flex-col sm:flex-row items-center justify-between gap-3"
	>
		<p class="text-slate-400">{footer.rights}</p>
		<p class="text-slate-500 flex items-center gap-1.5">
			Desarrollado por
			<a
				href={footer.developer.url}
				target="_blank"
				rel="noopener noreferrer"
				class="inline-flex items-center gap-1 font-medium text-slate-300 hover:text-brand transition-colors duration-300"
			>
				{footer.developer.name}
				<Icon name="arrow_forward" size={12} class="opacity-70" />
			</a>
		</p>
	</div>
</footer>
