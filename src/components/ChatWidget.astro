---
import { siteConfig } from "../config/siteConfig";
---

<div class="fixed bottom-6 right-6 z-50">
	<button
		class="group relative bg-cta text-white pl-4 pr-5 py-3.5 rounded-full font-semibold text-sm shadow-lg shadow-orange-500/30 hover:bg-cta-hover hover:shadow-xl hover:shadow-orange-500/40 hover:-translate-y-1 active:translate-y-0 transition-all duration-300 flex items-center gap-2.5 cursor-pointer overflow-hidden"
		aria-label={siteConfig.chatCta}
	>
		<span class="relative flex h-2.5 w-2.5">
			<span
				class="animate-ping absolute inline-flex h-full w-full rounded-full bg-white opacity-75"
			></span>
			<span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-white"></span>
		</span>
		<span class="material-symbols-outlined !text-[20px]">smart_toy</span>
		<span class="hidden md:inline">{siteConfig.chatCta}</span>
	</button>
</div>
